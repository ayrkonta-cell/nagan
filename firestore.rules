rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPlaylist(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.name is string &&
             data.name.size() >= 1 &&
             data.name.size() <= 60 &&
             data.description is string &&
             data.description.size() <= 200 &&
             data.trackCount is int &&
             data.trackCount >= 0 &&
             data.trackCount <= 5000 &&
             data.coverUrl is string &&
             data.coverUrl.size() <= 1000 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidPlaylistTrack(data, userId, playlistId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.playlistId is string &&
             data.playlistId == playlistId &&
             data.trackKey is string &&
             data.trackKey.size() >= 1 &&
             data.trackKey.size() <= 128 &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 200 &&
             data.artist is string &&
             data.artist.size() >= 1 &&
             data.artist.size() <= 200 &&
             data.album is string &&
             data.album.size() <= 200 &&
             data.source is string &&
             data.source in ['AUDIUS', 'ITUNES', 'DEEZER', 'ARCHIVE'] &&
             data.streamUrl is string &&
             data.streamUrl.size() >= 1 &&
             data.streamUrl.size() <= 1000 &&
             data.artworkUrl is string &&
             data.artworkUrl.size() <= 1000 &&
             data.durationSeconds is int &&
             data.durationSeconds >= 0 &&
             data.durationSeconds <= 86400 &&
             data.fullTrack is bool &&
             data.addedAt is timestamp &&
             data.addedAt <= request.time;
    }

    match /users/{userId}/playlists/{playlistId} {
      allow get: if isOwner(userId) && isValidId(playlistId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(playlistId) &&
                       incoming().keys().hasAll(['userId', 'name', 'description', 'trackCount', 'coverUrl', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'name', 'description', 'trackCount', 'coverUrl', 'createdAt', 'updatedAt']) &&
                       isValidPlaylist(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(playlistId) &&
                       isValidPlaylist(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['trackCount', 'coverUrl', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'trackCount', 'coverUrl', 'updatedAt'])
                       );

      allow delete: if isOwner(userId) && isValidId(playlistId);

      match /tracks/{trackId} {
        allow get: if isOwner(userId) && isValidId(playlistId) && isValidId(trackId);
        allow list: if isOwner(userId) && isValidId(playlistId);

        allow create: if isOwner(userId) &&
                         isValidId(playlistId) &&
                         isValidId(trackId) &&
                         incoming().keys().hasAll(['userId', 'playlistId', 'trackKey', 'title', 'artist', 'album', 'source', 'streamUrl', 'artworkUrl', 'durationSeconds', 'fullTrack', 'addedAt']) &&
                         incoming().keys().hasOnly(['userId', 'playlistId', 'trackKey', 'title', 'artist', 'album', 'source', 'streamUrl', 'artworkUrl', 'durationSeconds', 'fullTrack', 'addedAt']) &&
                         isValidPlaylistTrack(incoming(), userId, playlistId) &&
                         existsAfter(/databases/$(database)/documents/users/$(userId)/playlists/$(playlistId));

        allow update: if false;

        allow delete: if isOwner(userId) && isValidId(playlistId) && isValidId(trackId);
      }
    }
  }
}
